<form class="orbital-blues roll-dialog">
  <div class="form-group">
    <label>{{localize 'OB.Dialog.Mode'}}</label>
    <select name="mode">
      {{#each modes as |label key|}}
      <option value="{{key}}">{{localize label}}</option>
      {{/each}}
    </select>
  </div>

  {{#if isAttack}}
  <div class="form-group">
    <label>{{localize 'OB.Dialog.Difficulty'}}</label>
    <input type="number" name="difficulty" value="{{difficulty}}" />
  </div>
  <div class="form-group">
    <label>{{localize 'OB.Dialog.DamageBonus'}}</label>
    <input type="number" name="damageBonus" value="{{damageBonus}}" />
  </div>
  {{else}}
  <div class="form-group">
    <label>{{localize 'OB.Dialog.Bonus'}}</label>
    <input type="number" name="bonus" value="0" />
  </div>
  <div class="form-group">
    <label>{{localize 'OB.Dialog.Difficulty'}}</label>
    <input type="number" name="difficulty" value="{{difficulty}}" />
  </div>
  {{/if}}
</form>
